# Split Payment Service Configuration

# Service Configuration
SERVICE_NAME=split-payment-service
SERVICE_VERSION=1.0.0
NODE_ENV=development
PORT=8446
HOST=0.0.0.0

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=split_user
DB_PASSWORD=split_pass
DB_NAME=revenue_share
DB_SCHEMA=split_payments
DB_SSL=false
DB_SYNC=true
DB_MIGRATIONS=false
DB_LOGGING=true

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=split-payment-service
KAFKA_GROUP_ID=split-payment-service-group
KAFKA_TOPIC_PAYMENT_INSTRUCTIONS=payment-instructions
KAFKA_TOPIC_SPLIT_RESULTS=split-results
KAFKA_TOPIC_TAX_CALCULATIONS=tax-calculations
KAFKA_TOPIC_COMPLIANCE_EVENTS=compliance-events
KAFKA_TOPIC_ESCROW_EVENTS=escrow-events
KAFKA_TOPIC_WEBHOOK_EVENTS=webhook-events
KAFKA_TOPIC_DEAD_LETTER=split-payment-dlq
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_RETRIES=3
KAFKA_RETRY_DELAY=1000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
REDIS_TTL=3600

# gRPC Configuration
gRPC_SERVER_HOST=0.0.0.0
GRPC_SERVER_PORT=50053
GRPC_SERVER_SSL=false
LOWDATAESC_GRPC_HOST=lowdataesc.company.com
LOWDATAESC_GRPC_PORT=50051
LOWDATAESC_GRPC_SSL=true
LOWDATAESC_GRPC_TIMEOUT=10000
LOWDATAESC_GRPC_MAX_RETRIES=3
LOWDATAESC_GRPC_RETRY_DELAY=1000

# BACEN Configuration
BACEN_API_URL=https://api.bcb.gov.br
BACEN_PIX_URL=https://pix.bcb.gov.br
BACEN_API_TIMEOUT=30000
BACEN_API_KEY=
BACEN_CLIENT_ID=
BACEN_CLIENT_SECRET=
BACEN_SPLIT_ENABLED=true
BACEN_SPLIT_ENDPOINT=/split-payment/v1
BACEN_SPLIT_MAX_RETRIES=3
BACEN_CBS_RATES_ENDPOINT=/tax-rates/cbs
BACEN_CBS_CACHE_TTL=3600
BACEN_IBS_RATES_ENDPOINT=/tax-rates/ibs
BACEN_IBS_CACHE_TTL=3600

# Payment Gateway Configuration - Iugu
IUGU_ENABLED=true
IUGU_API_URL=https://api.iugu.com/v1
IUGU_API_KEY=
IUGU_ACCOUNT_ID=
IUGU_SPLIT_ENABLED=true
IUGU_SPLIT_ENDPOINT=/payments/split
IUGU_WEBHOOK_TOKEN=
IUGU_TIMEOUT=30000

# Payment Gateway Configuration - Asaas
ASAAS_ENABLED=true
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_SPLIT_ENABLED=true
ASAAS_SPLIT_ENDPOINT=/payments/split
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT=30000

# Payment Gateway Configuration - Efi
EFI_ENABLED=true
EFI_API_URL=https://api.efipay.com.br/v1
EFI_API_KEY=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_SPLIT_ENABLED=true
EFI_SPLIT_ENDPOINT=/payments/split
EFI_WEBHOOK_TOKEN=
EFI_TIMEOUT=30000

# Escrow Configuration
ESCROW_ENABLED=true
ESCROW_ACCOUNT_PREFIX=split-escrow
ESCROW_AUTO_CREATE=true
ESCROW_RETENTION_DAYS=30
ESCROW_ALERT_THRESHOLD=10000.00

# SPED Configuration
SPED_ENABLED=true
SPED_VERSION=2.0
SPED_FILE_PATH=./sped-output
SPED_BATCH_SIZE=100
SPED_AUTO_SEND=true
SPED_WEBHOOK_URL=

# Webhook Configuration
RF_WEBHOOK_ENABLED=true
RF_WEBHOOK_URL=https://webhook.receita.fazenda.gov.br/split-payment
RF_WEBHOOK_API_KEY=
RF_WEBHOOK_TIMEOUT=30000
RF_WEBHOOK_MAX_RETRIES=5
RF_WEBHOOK_RETRY_DELAY=5000
INTERNAL_PAYMENT_CALLBACK=/api/v1/webhook/payment
INTERNAL_SPLIT_CALLBACK=/api/v1/webhook/split
INTERNAL_TAX_CALLBACK=/api/v1/webhook/tax
INTERNAL_WEBHOOK_SECRET=

# Split Payment Configuration
SPLIT_MAX_RETRIES=5
SPLIT_RETRY_DELAY=5000
SPLIT_PROCESSING_TIMEOUT=60000
SPLIT_IDEMPOTENCY_TTL=86400
SPLIT_STATUS_UPDATE_INTERVAL=30000
DEFAULT_CBS_RATE=0.01
DEFAULT_IBS_RATE=0.02
MULTI_TENANT_ENABLED=true
TENANT_HEADER=X-Consortium-Id
DEFAULT_TENANT=default

# Health Check Configuration
HEALTH_LIVENESS_PATH=/health/live
HEALTH_READINESS_PATH=/health/ready
HEALTH_TIMEOUT=5000

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_MAX_FILES=10
LOG_MAX_SIZE=100m
LOG_DIR=./logs
AUDIT_LOG_ENABLED=true
AUDIT_S3_BUCKET=lowdataesc-audit-logs
AUDIT_S3_PREFIX=split-payment
AUDIT_WORM_ENABLED=true

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=10000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Alert Configuration
ALERT_ENABLED=true
AI_OWNER_EMAIL=ai-owner@lowdataesc.gov.br
AI_OWNER_PHONE=+5561999999999
AI_OWNER_SLACK=#split-payment-alerts
ALERT_PAYMENT_FAILURE_THRESHOLD=3
ALERT_SPLIT_FAILURE_THRESHOLD=5
ALERT_TAX_FAILURE_THRESHOLD=3
ALERT_ESCROW_BALANCE=100000.00

# Idempotency Configuration
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=86400
IDEMPOTENCY_HEADER=Idempotency-Key

# Security Configuration
MTLS_ENABLED=false
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=
ENCRYPTION_IV_LENGTH=16
MTLS_CERT_PATH=/certs/tls.crt
MTLS_KEY_PATH=/certs/tls.key
MTLS_CA_PATH=/certs/ca.crt

# Rate Limit Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# LOWDATAESC Configuration
LOWDATAESC_API_URL=https://api.lowdataesc.company.com
LOWDATAESC_API_KEY=
LOWDATAESC_API_TIMEOUT=30000
LOWDATAESC_ESCROW_PREFIX=revshare
LOWDATAESC_AUTO_CREATE=true
LOWDATAESC_SETTLEMENT_METHOD=PIX
LOWDATAESC_SUPPORTED_METHODS=PIX,TED,DOC,BOLETO
LOWDATAESC_MAX_AMOUNT=1000000.00
LOWDATAESC_MIN_AMOUNT=0.01
LOWDATAESC_CALLBACK_ENABLED=true
LOWDATAESC_CALLBACK_SECRET=

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
